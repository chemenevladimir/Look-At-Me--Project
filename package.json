{
  "name": "look-at-me-proctoring-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build && node scripts/build-extension.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --pretty false",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "lucide-react": "^0.453.0",
    "onnxruntime-web": "1.23.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "2.1.9"
  }
}
